# ============================================================
# naukri-agent environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- General ---
APP_ENV=development          # development | production
TIMEZONE=Asia/Kolkata
DRY_RUN=true                 # true = never submit applications
AUTO_APPLY=false             # false = every application requires human approval

# --- Database ---
DATABASE_URL=sqlite:///./data/naukri_agent.db

# --- Logging ---
LOG_DIR=./logs
LOG_LEVEL=INFO

# --- Candidate profile / master resume (Phase 2) ---
# Copy config/candidate_profile.example.yaml -> config/candidate_profile.yaml
# and config/master_resume.example.yaml -> config/master_resume.yaml,
# then fill in your own details. Both are gitignored.
CANDIDATE_PROFILE_PATH=./config/candidate_profile.yaml
MASTER_RESUME_PATH=./config/master_resume.yaml

# --- Resume registry (Phase 6) ---
# Copy config/resumes.example.yaml -> config/resumes.yaml and list
# your own existing resume files (this system never generates or
# edits resume content). Gitignored.
RESUME_REGISTRY_PATH=./config/resumes.yaml

# --- LLM configuration ---
# Provider is WHO serves the model. Model is WHICH model to ask for.
# These are independent — the same model name means nothing to the
# wrong provider, so keep both set consistently.
#
# Examples:
#   LLM_PROVIDER=ollama   LLM_MODEL=llama3.1
#   LLM_PROVIDER=groq     LLM_MODEL=llama-3.1-70b-versatile
#   LLM_PROVIDER=openai   LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Naukri credentials (Phase 7) ---
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# --- Browser automation (Phase 7) ---
# headless=false so you can see and solve CAPTCHA/MFA yourself.
NAUKRI_HEADLESS=false
BROWSER_PROFILE_DIR=./data/browser_profile
INSPECTION_OUTPUT_DIR=./inspection_output

# --- Digest email delivery (Stage A: file/console; SMTP added 2026-09-12) ---
# "file" (default) writes the digest under EMAIL_OUTPUT_DIR -- nothing
# is sent anywhere. "console" prints it. "smtp" sends a real email via
# the SMTP_* settings below -- ALL FOUR of SMTP_HOST/SMTP_USERNAME/
# SMTP_PASSWORD/NOTIFY_EMAIL_TO must be set or the run fails clearly
# (EmailConfigError) rather than silently falling back to a file.
EMAIL_SENDER=file

# --- SMTP (only used when EMAIL_SENDER=smtp) ---
# Works with any standard STARTTLS SMTP provider. For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=<your full gmail address>
#   SMTP_PASSWORD=<a 16-character Gmail APP PASSWORD, not your normal
#                   account password -- Google requires 2-Step
#                   Verification to be enabled first, then generate one
#                   at https://myaccount.google.com/apppasswords>
# Never put the password directly in code, and never log it -- keep it
# in this .env file only, which is gitignored.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
